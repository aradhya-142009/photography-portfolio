<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Work — ARADHYA</title>
  <meta name="description" content="Selected frames from Aradhya Jadaun's photography — a filterable contact sheet of portrait, street, and landscape shots.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,600;1,9..144,400&family=Space+Grotesk:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div class="scroll-progress" id="scrollProgress"></div>
  <div class="grain"></div>

  <header class="nav" id="nav">
    <a href="index.html" class="nav__mark">A—J</a>
    <nav class="nav__links">
      <a href="work.html" class="active-link">Work</a>
      <a href="about.html">About</a>
      <a href="feedback.html">Feedback</a>
      <a href="login.html">Login</a>
      <a href="contact.html">Contact</a>
    </nav>
  </header>

  <section class="work" id="work">
    <div class="work__head">
      <div>
        <p class="eyebrow">Contact Sheet</p>
        <h2 class="work__title">Selected frames</h2>
      </div>
      <div class="filters" id="filters">
        <button class="filter active" data-filter="all">All</button>
        <button class="filter" data-filter="street">Street</button>
        <button class="filter" data-filter="landscape">Landscape</button>
      </div>
    </div>

    <div class="sheet" id="sheet">
      <figure class="frame" data-cat="street">
        <span class="frame__id">01A</span>
        <div class="frame__img"><img src="https://images.unsplash.com/photo-1599661046827-dacff0c0f09a?auto=format&fit=crop&w=800&q=80" alt="Johari Bazaar"></div>
        <figcaption class="frame__exif">CANON 1500D · 35mm · f/4 · 1/500 · ISO 400</figcaption>
      </figure>

      <figure class="frame frame--wide" data-cat="landscape">
        <span class="frame__id">02A</span>
        <div class="frame__img"><img src="https://images.unsplash.com/photo-1603262110263-fb0112e7cc33?auto=format&fit=crop&w=1200&q=80" alt="Amber Fort"></div>
        <figcaption class="frame__exif">CANON 1500D · 18mm · f/8 · 1/125 · ISO 100</figcaption>
      </figure>

      <figure class="frame" data-cat="street">
        <span class="frame__id">03A</span>
        <div class="frame__img"><img src="https://images.unsplash.com/photo-1524492412937-b28074a5d7da?auto=format&fit=crop&w=800&q=80" alt="Bapu Bazaar"></div>
        <figcaption class="frame__exif">CANON 1500D · 35mm · f/5.6 · 1/320 · ISO 320</figcaption>
      </figure>

      <figure class="frame" data-cat="landscape">
        <span class="frame__id">04A</span>
        <div class="frame__img"><img src="https://images.unsplash.com/photo-1567157577867-05ccb1388e66?auto=format&fit=crop&w=800&q=80" alt="Nahargarh Fort"></div>
        <figcaption class="frame__exif">CANON 1500D · 24mm · f/9 · 1/60 · ISO 100</figcaption>
      </figure>

      <figure class="frame frame--wide" data-cat="street">
        <span class="frame__id">05A</span>
        <div class="frame__img"><img src="https://images.unsplash.com/photo-1590050752117-238cb0fb12b1?auto=format&fit=crop&w=1200&q=80" alt="Pink City Streets"></div>
        <figcaption class="frame__exif">CANON 1500D · 50mm · f/2.8 · 1/250 · ISO 250</figcaption>
      </figure>

      <figure class="frame" data-cat="landscape">
        <span class="frame__id">06A</span>
        <div class="frame__img"><img src="https://images.unsplash.com/photo-1617854818583-09e7f077a156?auto=format&fit=crop&w=800&q=80" alt="Aravalli Hills"></div>
        <figcaption class="frame__exif">CANON 1500D · 18mm · f/6.3 · 1/250 · ISO 100</figcaption>
      </figure>

      <figure class="frame" data-cat="landscape">
        <span class="frame__id">07A</span>
        <div class="frame__img"><img src="https://images.unsplash.com/photo-1582510003544-4d00b7f74220?auto=format&fit=crop&w=800&q=80" alt="Jaigarh Fort"></div>
        <figcaption class="frame__exif">CANON 1500D · 24mm · f/8 · 1/200 · ISO 100</figcaption>
      </figure>

      <figure class="frame frame--wide" data-cat="landscape">
        <span class="frame__id">08A</span>
        <div class="frame__img"><img src="https://images.unsplash.com/photo-1596178065887-1198b6148b2b?auto=format&fit=crop&w=1200&q=80" alt="Patrika Gate"></div>
        <figcaption class="frame__exif">CANON 1500D · 18mm · f/7.1 · 1/160 · ISO 200</figcaption>
      </figure>
    </div>
  </section>

  <footer class="footer">
    <span>© 2026 Aradhya Jadaun</span>
    <div class="footer__socials">
      <a href="https://instagram.com" target="_blank">Instagram</a>
      <a href="https://linkedin.com" target="_blank">LinkedIn</a>
    </div>
  </footer>

  <script src="script.js"></script>
</body>
</html>
